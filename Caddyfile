www.trendzaerox.com {
    redir https://trendzaerox.com{uri} permanent
}

trendzaerox.com {
    encode zstd gzip

    reverse_proxy frontend:3000
}

api.trendzaerox.com {
    encode zstd gzip

    handle_path /uploads/* {
        root * /srv/uploads

        header {
            Cache-Control "public, max-age=31536000, immutable"
            X-Content-Type-Options "nosniff"
            Access-Control-Allow-Origin "*"
        }

        file_server
    }

    handle {
        reverse_proxy backend:8080
    }
}